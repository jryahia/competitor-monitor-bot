# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_private_channel_id_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Competitor URLs (comma-separated, up to 5)
COMPETITOR_URLS=https://example1.com/products,https://example2.com/shop,https://example3.com

# Optional tuning
STATE_FILE=state.json
CHECK_INTERVAL_HOURS=24
PRICE_DROP_THRESHOLD=0.10
